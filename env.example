# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# Строка подключения к Postgres
DATABASE_URL=

# Redis для распределённого rate limiting (в Docker Compose адрес уже задан)
REDIS_URL=redis://localhost:6379/0

# Доверять X-Real-IP, только если запросы проходят через ваш reverse proxy
TRUST_PROXY_HEADERS=false

# Часовой пояс для дедлайнов и напоминаний (необязательно, по умолчанию Europe/Moscow)
BOT_TIMEZONE=Europe/Moscow

# Публичный HTTPS-адрес мини-аппа (необязательно; без него бот работает без кнопки меню)
MINI_APP_URL=https://todolist.ooyble.online

# Порт, который слушает встроенный веб-сервер мини-аппа (необязательно, по умолчанию 8080)
PORT=8080

# Секрет подписи access JWT (сгенерируйте случайную строку длиной не менее 32 символов)
JWT_SECRET=
